        Light theme, pinned. The previous parent was DayNight, which turned the text
        white in dark mode while the background stayed light: an all-white screen.
    -->
    <style name="Theme.CallRecorder" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#3F51B5</item>
        <item name="colorPrimaryVariant">#303F9F</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#FF4081</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#1A1A1A</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:textColorPrimary">#1A1A1A</item>
        <item name="android:textColorSecondary">#757575</item>
        <item name="android:statusBarColor">#303F9F</item>
    </style>
</resources>
